*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Office lock files, written beside a document while it is open in PowerPoint or
# Word. Never publishable, and worse than clutter: mkdocs build fails outright
# with a PermissionError trying to copy one out of docs/downloads/ while Office
# still holds it. That is how this line came to be here.
~$*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Source artwork, kept local. The cut-out that the site actually serves is
# docs/assets/img/di4a-robot.webp at 167 KB; the 2 MB original does not need
# to travel in the history, which already weighs 44 MB.
images/
